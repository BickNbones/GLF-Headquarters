  "records": [
    {
      "category": "Most Championships",
      "value": "3× Rings",
      "holder": "Tyler Shaver",
      "description": "2019, 2020, 2023 — the only 3-time champion in GFL history"
    },
    {
      "category": "Only Back-to-Back Champ",
      "value": "2019 & 2020",
      "holder": "Tyler Shaver",
      "description": "Won back-to-back. Nobody else has ever repeated. Not once."
    },
    {
      "category": "All-Time Wins Leader",
      "value": "106 Wins",
      "holder": "Danny Sattler",
      "description": "14 seasons, never won a ring — the most decorated non-champion in GFL history"
    },
    {
      "category": "Best Career Win %",
      "value": "60.9%",
      "holder": "Tavis Tucker",
      "description": "98-63 over 12 seasons — best among managers with 10+ seasons"
    },
    {
      "category": "Highest Single-Season PF",
      "value": "1,702 pts",
      "holder": "Sean O'Connell",
      "description": "Set the all-time GFL scoring record in only his 2nd season (2024)"
    },
    {
      "category": "Best Single-Season Record",
      "value": "12-1",
      "holder": "Doug Meyer",
      "description": "2018 — best regular-season record in GFL history"
    },
    {
      "category": "Best Regular Season (12W)",
      "value": "12-2",
      "holder": "Danny Sattler",
      "description": "2022 — led the league in wins that year, still didn't win the chip"
    },
    {
      "category": "Founding Members Still Active",
      "value": "2 OGs",
      "holder": "Danny · Collin",
      "description": "Both have been in the GFL since Season 1 (2012) and remain active after Tom Campbell retired"
    },
    {
      "category": "Most All-Time Losses",
      "value": "108 L",
      "holder": "Collin Wilson",
      "description": "14 seasons, 108 losses — the most in GFL history. And still got a ring in 2022. Redemption arc complete."
    },
    {
      "category": "Greatest Cinderella Story",
      "value": "Last → Champ",
      "holder": "Owen Garritt",
      "description": "4-10, dead last (12th) in 2021 debut → 11-3, GFL Champion in 2024"
    },
    {
      "category": "Fastest Rise to Contention",
      "value": "2-yr turnaround",
      "holder": "Owen Garritt",
      "description": "From worst record to championship in just 3 seasons"
    },
    {
      "category": "Boldest Name Theft",
      "value": "Barton Spartans",
      "holder": "Matt Kitson",
      "description": "Stole Tom Campbell's original team name. Tom had to rebrand to Monti Thunderboltz."
    },
    {
      "category": "Most Loyal to One Name",
      "value": "8 Seasons",
      "holder": "Kris Cappiello",
      "description": "Space Cadets — never changed. Not once. Back for Season XV with the same name."
    },
    {
      "category": "Worst Single Season",
      "value": "1-12",
      "holder": "Tom Campbell (2017) & Kris (2014)",
      "description": "Both hit the floor hard — the GFL crater record, shared."
    },
    {
      "category": "Newest Manager",
      "value": "2023",
      "holder": "Sean O'Connell",
      "description": "Joined as Eskimo Brothers — came in late, set the all-time scoring record by Year 2"
    },
    {
      "category": "Most Heartbreaking Regular Season",
      "value": "12-1, No Ring",
      "holder": "Doug Meyer",
      "description": "2018 — best regular season record in GFL history. Lost the championship to Kyle O'Connell who went 9-4. The injustice lives on."
    },
    {
      "category": "Champion in Rookie Season",
      "value": "Year 1 → 🏆",
      "holder": "Tyler Shaver",
      "description": "2019 — walked into the GFL and won the championship in his very first season. Never been done before or since."
    },
    {
      "category": "Best Regular Season Without a Ring",
      "value": "11-2, Still Lost",
      "holder": "Tavis Tucker",
      "description": "2019 — went 11-2, led the league in PF with 1,534 pts. Lost the championship to a first-year Tyler Shaver. Remains the greatest robbery in GFL history."
    },
    {
      "category": "Best Team Name in GFL History",
      "value": "Cocks N' Glocks",
      "holder": "rob ohlerich",
      "description": "Pennsyltucky Cocks N' Glocks — a GFL legend from 2013–2016. Retired with the greatest team name the league has ever seen."
    },
    {
      "category": "Shortest Career",
      "value": "2 Seasons",
      "holder": "Josh Hickey",
      "description": "2017-2018. Runner-up in his first year (9-4), then went 2-11 in Year 2 and was never heard from again. A cautionary tale."
    }
  ],
